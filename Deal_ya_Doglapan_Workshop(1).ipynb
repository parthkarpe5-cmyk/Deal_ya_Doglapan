    }
   },
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "Blanks per feature (train):\n",
      "log_revenue      65\n",
      "log_multiple     97\n",
      "gross_margin    173\n",
      "ebitda          223\n",
      "cash_burn        93\n",
