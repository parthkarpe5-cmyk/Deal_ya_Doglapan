    "\n",
    "votes = [\"Deal\", \"No Deal\", \"Deal\"]\n",
    "ax_rf.bar([\"Tree 1\", \"Tree 2\", \"Tree 3\"], [1, 1, 1], color=[teal, muted, teal], width=.68)\n",
