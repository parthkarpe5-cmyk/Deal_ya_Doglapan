   ],
   "source": [
    "X_test, y_test = handoff[\"X_test\"], handoff[\"y_test\"]\n",
    "test_rows = []\n",
    "predictions = {}\n",
    "for name, pipeline in pipelines.items():\n",
    "    pipeline.fit(X_train, y_train)\n",
    "    predicted = pipeline.predict(X_test)\n",
    "    probability = pipeline.predict_proba(X_test)[:, 1]\n",
    "    predictions[name] = predicted\n",
    "    test_rows.append({\n",
    "        \"Model\": name,\n",
    "        \"Test Accuracy\": accuracy_score(y_test, predicted),\n",
    "        \"Test Balanced Acc.\": balanced_accuracy_score(y_test, predicted),\n",
    "        \"Test Deal F1\": f1_score(y_test, predicted, zero_division=0),\n",
    "        \"Test ROC AUC\": roc_auc_score(y_test, probability),\n",
    "    })\n",
    "\n",
    "results = training_scores.join(pd.DataFrame(test_rows).set_index(\"Model\"))\n",
    "display(results.round(3))"
   ],
