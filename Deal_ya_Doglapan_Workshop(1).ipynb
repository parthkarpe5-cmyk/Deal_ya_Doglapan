   <td>5.0</td>\n      <td>Beauty/Fashion</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>4.510860</td>\n      <td>1.25</td>\n      <td>7.221836</td>\n      <td>1.660731</td>\n      <td>77.0</td>\n      <td>14.0</td>\n      <td>1</td>\n      <td>0.0</td>\n      <td>0.0</td>\n      <td>0</td>\n      <td>0.0</td>\n      <td>5.0</td>\n      <td>Beauty/Fashion</td>\n    </tr>\n  </tbody>\n</table>\n</div>"
