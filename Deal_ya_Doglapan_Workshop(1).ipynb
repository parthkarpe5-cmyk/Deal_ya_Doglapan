     "output_type": "stream",
     "name": "stdout",
     "text": [
      "Before preprocessing: 13 columns  ‚Üí  after: 24 columns\n",
      "Blanks left: 0\n",
      "Industry columns created: ['Beauty/Fashion', 'Business Services', 'Children/Education', 'Fitness/Sports/Outdoors', 'Food and Beverage', 'Green/CleanTech', 'Lifestyle/Home', 'Manufacturing', 'Medical/Health', 'Technology/Software', 'Vehicles/Electrical Vehicles', 'infrequent_sklearn']\n"
     ]
    }
   ],
   "source": [
    "NUM = [c for c in X.columns if c != \"industry\"]\n",
    "CAT = [\"industry\"]\n",
    "preprocessor = ColumnTransformer([\n",
    "    (\"numbers\", Pipeline([(\"fill_blanks\", SimpleImputer(strategy=\"median\")),\n",
    "                          (\"scale\", StandardScaler())]), NUM),\n",
    "    (\"industry\", OneHotEncoder(min_frequency=20, handle_unknown=\"infrequent_if_exist\", sparse_output=False), CAT),\n",
    "])\n",
    "demo = clone(preprocessor).fit(X_train)  # Demonstration fit, using training only\n",
    "Xt_train = demo.transform(X_train)\n",
    "print(f\"Before preprocessing: {X_train.shape[1]} columns  ‚Üí  after: {Xt_train.shape[1]} columns\")\n",
    "print(\"Blanks left:\", int(np.isnan(Xt_train).sum()))\n",
    "print(\"Industry columns created:\", [n.replace(\"industry__industry_\", \"\") for n in demo.get_feature_names_out() if n.startswith(\"industry__\")])"
   ]
  },
  {
