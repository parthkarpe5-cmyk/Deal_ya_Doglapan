      "text/html": "<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>Startup Name</th>\n      <th>Original Ask Amount</th>\n      <th>Original Offered Equity</th>\n      <th>Valuation Requested</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>162</th>\n      <td>TadkaSnacksGo</td>\n      <td>4500000.0</td>\n      <td>2.0</td>\n      <td>2250.00</td>\n    </tr>\n    <tr>\n      <th>263</th>\n      <td>PeakCamp</td>\n      <td>25000000.0</td>\n      <td>3.0</td>\n      <td>8333.33</td>\n    </tr>\n    <tr>\n      <th>314</th>\n      <td>SmartHubOne</td>\n      <td>4000000.0</td>\n      <td>2.0</td>\n      <td>2000.00</td>\n    </tr>\n    <tr>\n      <th>544</th>\n      <td>DesiKart</td>\n      <td>5000000.0</td>\n      <td>0.5</td>\n      <td>10000.00</td>\n    </tr>\n    <tr>\n      <th>664</th>\n      <td>ByteLabs</td>\n      <td>4500000.0</td>\n      <td>1.5</td>\n      <td>3000.00</td>\n    </tr>\n    <tr>\n      <th>882</th>\n      <td>DesiSnacksGo</td>\n      <td>17500000.0</td>\n      <td>3.0</td>\n      <td>5833.33</td>\n    </tr>\n    <tr>\n      <th>920</th>\n      <td>KisanGrow</td>\n      <td>6000000.0</td>\n      <td>3.5</td>\n      <td>1714.29</td>\n    </tr>\n    <tr>\n      <th>957</th>\n      <td>SuryaTechX</td>\n      <td>4500000.0</td>\n      <td>2.0</td>\n      <td>2250.00</td>\n    </tr>\n  </tbody>\n</table>\n</div>"
